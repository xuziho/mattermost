exports[`components/admin_console/license_settings/LicenseSettings should match snapshot enterprise build with E10 license 1`] = `
<div>
  <div
    class="wrapper--fixed"
  >
    <div
      class="admin-console__header"
    >
      Edition and License
    </div>
    <div
      class="admin-console__wrapper"
    >
      <div
        class="admin-console__content"
      >
        <div
          class="admin-console__banner_section"
        />
        <div
          class="top-wrapper"
        >
          <div
            class="left-panel"
          >
            <div
              class="panel-card"
            >
              <div
                class="EnterpriseEditionLeftPanel"
                data-testid="EnterpriseEditionLeftPanel"
              >
                <div
                  class="EnterpriseEditionLeftPanel__Header"
                >
                  <div>
                    <div
                      class="EnterpriseEditionLeftPanel__Title"
                    >
                      Mattermost Enterprise E10
                    </div>
                  </div>
                </div>
                <div
                  class="licenseInformation"
                >
                  <div
                    class="licenseInformation__Header"
                  >
                    <span
                      class="licenseInformation__Title"
                    >
                      License details
                    </span>
                  </div>
                  <div
                    class="licenseElements"
                  >
                    <div
                      class="item-element"
                    >
                      <span
                        class="legend"
                      >
                        START DATE:
                      </span>
                      <span
                        class="value"
                      >
                        2/4/2018
                      </span>
                    </div>
                    <div
                      class="item-element"
                    >
                      <span
                        class="legend"
                      >
                        EXPIRES:
                      </span>
                      <span
                        class="value"
                      >
                        5/6/2021
                      </span>
                      <span
                        class="expiration-days expiration-days-warning"
                      >
                        Expires in 22 days
                      </span>
                    </div>
                    <div
                      class="item-element"
                    >
                      <span
                        class="legend"
                      >
                        LICENSED SEATS:
                      </span>
                      <span
                        class="value"
                      >
                        100
                      </span>
                    </div>
                    <div
                      class="item-element"
                    >
                      <span
                        class="legend"
                      >
                        ACTIVE USERS:
                      </span>
                      <span
                        class="value"
                      >
                        0
                      </span>
                    </div>
                    <div
                      class="item-element"
                    >
                      <span
                        class="legend"
                      >
                        EDITION:
                      </span>
                      <span
                        class="value"
                      >
                        Enterprise E10 local license
                      </span>
                    </div>
                    <div
                      class="item-element"
                    >
                      <span
                        class="legend"
                      >
                        LICENSE ISSUED:
                      </span>
                      <span
                        class="value"
                      >
                        2/4/2018
                         
                        3:24 AM
                      </span>
                    </div>
                    <div
                      class="item-element"
                    >
                      <span
                        class="legend"
                      >
                        NAME:
                      </span>
                      <span
                        class="value"
                      >
                        LicenseName
                      </span>
                    </div>
                    <div
                      class="item-element"
                    >
                      <span
                        class="legend"
                      >
                        COMPANY / ORG:
                      </span>
                      <span
                        class="value"
                      >
                        Mattermost Inc.
                      </span>
                    </div>
                    <hr />
                    <button
                      class="btn btn-secondary"
                    >
                      Add a new license
                    </button>
                    <input
                      accept=".mattermost-license"
                      style="display: none;"
                      type="file"
                    />
                    <div
                      class="remove-button"
                    >
                      <button
                        class="btn btn-danger"
                        data-testid="remove-button"
                        id="remove-button"
                        type="button"
                      >
                        Remove local license
                      </button>
                    </div>
                  </div>
                </div>
                <div
                  class="license-notices"
                >
                  <p>
                    This software is offered under a commercial license.

See ENTERPRISE-EDITION-LICENSE.txt in your root install directory for details. See NOTICE.txt for information about open source software used in this system.
                  </p>
                </div>
              </div>
            </div>
          </div>
          <div
            class="right-panel"
          >
            <div
              class="panel-card"
            >
              <div
                class="EnterpriseEditionRightPannel"
              >
                <div
                  class="license-title"
                >
                  Local license details
                </div>
                <div
                  class="license-subtitle"
                >
                  <div
                    class="advantages-list"
                  >
                    <div
                      class="item"
                    >
                      <i
                        class="fa fa-lock"
                      />
                      File-based local license management
                    </div>
                    <div
                      class="item"
                    >
                      <i
                        class="fa fa-lock"
                      />
                      Compatibility with existing license APIs
                    </div>
                    <div
                      class="item"
                    >
                      <i
                        class="fa fa-lock"
                      />
                      Works without external billing or account services
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
`;

